---
import Icon from './Icon.astro';
import MobileShelf from './MobileShelf.astro';
import {identities} from '../data/identities';
---
<section class="brand-documents section wrap" id="identidades" aria-labelledby="documents-title">
 <div class="section-heading"><div><p class="eyebrow">Cadernos de identidade</p><h2 id="documents-title">A marca <em>por dentro.</em></h2></div><p class="section-description">Escolha um caderno para ver como a assinatura, a cor e a letra se comportam nas peças.</p></div>
 <MobileShelf target="document-shelf" label="Documentos de marca" total={identities.length}/>
 <div class="brand-document-grid mobile-shelf" id="document-shelf" data-mobile-shelf tabindex="0" role="region" aria-label="Documentos de identidade visual">
 {identities.map((board,i)=><a class:list={['brand-document-card',`document-card-${board.theme}`]} href={`/identidades/${board.slug}/`}>
   <div class="brand-document-image"><img src={board.slug==='glifo'?'/brand/oficio/lamina.webp':board.hero} alt="" width="1360" height="1110" loading="lazy"/>
    <figure class="amostra-do-caderno" aria-hidden="true"><img src={`/identities/amostras/${board.slug}.webp`} alt="" loading="lazy"/><figcaption>{board.materials[0].title}</figcaption></figure><div class="arquivo-pigmentos" aria-hidden="true">{board.colors.slice(0,5).map(c=><i style={`background:${c.hex}`}/>)}</div></div>
   <div class="arquivo-legenda"><small>{String(i+1).padStart(2,'0')}</small><div><h3>{board.name}</h3><p>{board.subtitle}</p></div><Icon name="arrow"/></div>
 </a>)}
 </div>
</section>
