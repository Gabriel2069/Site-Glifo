---
import {myth} from '../data/site';

const plates = [
 {id:'sinais', label:'Sinais', image:'carta', alt:'Compasso de latão aberto sobre uma carta azul com pontos e linhas de constelação.'},
 {id:'glifos', label:'Glifos', image:'tipos', alt:'Tipos móveis de metal vistos de perto, com um G de latão invertido entre as letras de prata.'},
 {id:'grifo', label:'Grifo', image:'grifo', alt:'O emblema do grifo em dourado sobre um caderno violeta, apoiado em um volume petróleo.'}
];
---
<section id="origem" class="ensaio" aria-labelledby="myth-title">
 <header class="ensaio-abertura">
  <div class="ensaio-cabeca">
   <p class="eyebrow">Sobre glifos, figuras e constelações</p>
   <h2 id="myth-title">O que um sinal<br/><em>permite dizer.</em></h2>
   <p class="ensaio-intro">O céu fornece uma imagem para a marca: pontos que, vistos em relação, passam a formar algo legível. Cada constelação pode ser um glifo.</p>
   <nav aria-label="Capítulos do ensaio">{plates.map(plate=><a href={`#ensaio-${plate.id}`}>{plate.label}</a>)}</nav>
  </div>
  <figure class="ensaio-carta"><img src="/brand/ensaio/carta.webp" width="1152" height="864" loading="lazy" alt={plates[0].alt}/></figure>
 </header>
 {myth.map((chapter,i)=><article class={`ensaio-capitulo ensaio-${plates[i].id}`} id={`ensaio-${plates[i].id}`} aria-labelledby={`titulo-${plates[i].id}`}>
  {i>0&&<figure><img src={`/brand/ensaio/${plates[i].image}.webp`} width="1152" height="864" loading="lazy" alt={plates[i].alt}/></figure>}
  <div class="ensaio-texto">
   <header><p class="eyebrow">{chapter.note}</p><h3 id={`titulo-${plates[i].id}`}>{chapter.title}</h3></header>
   <div class="ensaio-prosa">{chapter.text.split('\n\n').map(paragraph=><p data-reading-prose>{paragraph}</p>)}</div>
  </div>
 </article>)}
</section>

<style>
 .ensaio {--papel:#e8e5da;--tinta:#122d36;background:var(--tinta);color:var(--papel)}
 .ensaio h2,.ensaio h3 {font-family:var(--serif);font-weight:400;letter-spacing:-.045em;margin:0}
 .ensaio figure {margin:0;overflow:hidden}
 .ensaio figure img {width:100%;height:100%;display:block;object-fit:cover}
 .ensaio-abertura {display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.22fr);align-items:stretch}
 .ensaio-cabeca {align-self:center;padding:clamp(52px,7vw,115px) var(--page-gutter)}
 .ensaio h2 {font-size:clamp(52px,6.2vw,106px);line-height:.97}
 .ensaio h2 em {font-style:normal;color:#d9bd85}
 .ensaio .eyebrow {color:inherit;font-family:var(--sans);margin:0 0 20px;line-height:1.5}
 .ensaio-intro,.ensaio-prosa p {font:400 clamp(15px,1.13vw,19px)/1.72 var(--sans);color:inherit}
 .ensaio-intro {max-width:41ch;margin:24px 0}
 .ensaio-cabeca nav {display:flex;gap:22px;flex-wrap:wrap}
 .ensaio-cabeca nav a {display:inline-flex;align-items:center;min-height:44px;color:#e0c89b;text-decoration:underline;text-underline-offset:.4em;font:600 12px var(--sans)}
 .ensaio-cabeca nav a:is(:hover,:focus-visible){color:white}
 .ensaio-carta {min-width:0;background:#344448}
 .ensaio-capitulo {scroll-margin-top:90px}
 .ensaio-texto {padding:clamp(48px,6vw,100px) var(--page-gutter)}
 .ensaio h3 {font-size:clamp(39px,4.6vw,82px);line-height:1.02;text-wrap:balance}
 .ensaio-prosa {max-width:56ch}
 .ensaio-prosa p {margin:0}
 .ensaio-prosa p+p {margin-top:1.05em}
 .ensaio-sinais {background:var(--papel);color:var(--tinta);border-bottom:1px solid #acb0a8}
 .ensaio-sinais .ensaio-texto {max-width:1550px;margin:auto;display:grid;grid-template-columns:.9fr 1.1fr;gap:6vw;align-items:start}
 .ensaio-glifos,.ensaio-grifo {display:grid;align-items:stretch;grid-template-columns:minmax(0,1.05fr) minmax(0,1fr)}
 .ensaio-glifos {background:#d9ddd2;color:var(--tinta)}
 .ensaio-capitulo figure {min-width:0;position:relative}
 .ensaio-capitulo figure img {position:absolute;inset:0}
 .ensaio-glifos h3,.ensaio-grifo h3 {margin-bottom:26px}
 .ensaio-grifo {background:#31233e;grid-template-columns:minmax(0,1fr) minmax(0,1.12fr)}
 .ensaio-grifo figure {grid-column:2;grid-row:1}
 .ensaio-grifo .ensaio-texto {grid-column:1;grid-row:1}
 .ensaio-grifo .eyebrow {color:#e0c89b}
 @media(min-width:1700px){.ensaio-cabeca,.ensaio-capitulo .ensaio-texto {padding-inline:max(var(--page-gutter),6vw)}}
 @media(max-width:760px){
  .ensaio-abertura,.ensaio-sinais .ensaio-texto,.ensaio-glifos,.ensaio-grifo {display:block}
  .ensaio-cabeca,.ensaio-texto {padding:40px var(--page-gutter)}
  .ensaio h2 {font-size:clamp(48px,10vw,72px)}
  .ensaio-intro {margin:16px 0 7px}
  .ensaio-prosa {margin-top:19px}
  .ensaio figure {aspect-ratio:1.55}
  .ensaio .eyebrow {margin-bottom:13px}
 }
</style>
