---
import Icon from './Icon.astro';
import { projects } from '../data/site';
import ExhibitArt from './ExhibitArt.astro';
const order=['christiano-tadeu','delfas-corpore','acolher-comissao','tadeon','tdv-editorial','nexos'];
const selection=order.map(slug=>projects.find(p=>p.slug===slug)!);
---
<section class="work-collection section wrap" id="trabalhos" aria-labelledby="collection-title"><div class="section-heading"><div><p class="eyebrow">Portfólio selecionado</p><h2 id="collection-title">Trabalhos <em>do estúdio.</em></h2></div><p class="section-description">Identidade, editorial e digital. Selecione um projeto para examinar as peças.</p></div><div id="outros-trabalhos"></div><div class="collection-layout"><div class="collection-tabs" role="tablist" aria-label="Projetos selecionados" aria-orientation="horizontal">{selection.map((p,i)=><button id={`project-tab-${p.slug}`} type="button" role="tab" aria-controls={`project-panel-${p.slug}`} aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1} data-project-tab><span class="amostra-projeto" aria-hidden="true"><img src={({ 'christiano-tadeu':'/projects/christiano-home.webp','delfas-corpore':'/identities/delfas/manual-1.webp','acolher-comissao':'/identities/acolher/acolher-slide-1.webp'} as Record<string,string>)[p.slug]||p.image} alt="" loading="lazy"/></span><strong>{p.title}</strong><small>{p.categories.join(' / ')}</small><span class="project-tab-arrow" aria-hidden="true"><Icon name="arrow"/></span></button>)}</div><div class="collection-panels">{selection.map((p,i)=><article role="tabpanel" id={`project-panel-${p.slug}`} aria-labelledby={`project-tab-${p.slug}`} hidden={i!==0} class="collection-panel" data-collection-project={p.slug}><a href={`/trabalhos/${p.slug}/`} aria-label={`Explorar ${p.title}`}><ExhibitArt project={p}/></a><div class="collection-caption"><div><p class="eyebrow collection-project-name">{p.title} / {p.year}</p><h3>{p.lead}</h3><p>{p.summary}</p></div><div class="project-entry-links"><a href={`/trabalhos/${p.slug}/`} class="quiet-link">Explorar o projeto <Icon name="arrow"/></a>{p.board&&<a href={`/identidades/${p.board}/`} class="quiet-link">Abrir documento da marca <Icon name="arrow"/></a>}</div></div><p class="visual-provenance">{p.slug==='delfas-corpore'?'Capa e estudo cromático da proposta de reposicionamento.':p.slug==='acolher-comissao'?'Duas apresentações para projetos com identidades próprias.':p.slug==='christiano-tadeu'?'Site de apresentação e página de links do consultor.':p.caption}</p></article>)}</div></div><a href="/trabalhos/" class="line-link collection-all">Percorrer todos os trabalhos <span aria-hidden="true"><Icon name="arrow"/></span></a></section>
