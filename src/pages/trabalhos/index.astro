---
import WhatsApp from '../../components/WhatsApp.astro';
import ProjectConstellation from '../../components/ProjectConstellation.astro';
import Motto from '../../components/Motto.astro';
import Icon from '../../components/Icon.astro';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects,site } from '../../data/site';
const order=['christiano-tadeu','delfas-corpore','glifo','tadeon','tdv-editorial','nexos','acolher-comissao'];
const selection=order.map(slug=>projects.find(p=>p.slug===slug)!);
---
<Base title="Trabalhos · Glifo" bodyClass="work-directory"><section class="page-intro work-intro wrap"><div class="work-intro-copy"><p class="eyebrow">A vitrine / Trabalhos</p><h1>Cada projeto,<br/>uma linguagem <em>própria.</em></h1><p>Uma marca profissional, um livro, uma interface. Aqui, cada trabalho mostra como uma ideia ganhou desenho, organização e presença.</p><a href="/identidades/" class="quiet-link">Abrir os documentos de marca <Icon name="arrow"/></a></div><aside class="arquivo-leque" aria-label="Peças do acervo">
 {[
   ['tdv-editorial','/projects/tdv-cover.webp','Tessitura do Vazio'],
   ['delfas-corpore','/identities/delfas/manual-1.webp','Delfas Corpore'],
   ['glifo','/brand/oficio/matriz-detalhe.webp','Glifo']
 ].map(([slug,img,title])=><a href={`/trabalhos/${slug}/`} aria-label={`Ver ${title}`}><img src={img} alt="" loading="eager"/><span>{title} <Icon/></span></a>)}
 </aside></section><section class="work-selection wrap" aria-label="Escolher uma área"><div class="project-filters" role="group" aria-label="Filtrar trabalhos">{['Todos','Digital','Editorial','Identidade'].map((filter,i)=><button type="button" data-project-filter={filter} aria-pressed={i===0?'true':'false'}>{filter}<span aria-hidden="true">{filter==='Todos'?projects.length:projects.filter(p=>p.categories.includes(filter)).length}</span></button>)}</div><p class="project-filter-count" data-project-filter-count role="status">{projects.length} trabalhos</p></section><section class="wrap project-index" aria-label="Projetos" data-work-index>{selection.map((p,i)=><ProjectCard project={p} index={i}/>)}</section><ProjectConstellation/><section class="work-index-end wrap"><div><p class="eyebrow">A próxima ideia</p><h2><Motto/></h2></div><a class="line-link" href={site.contact.whatsapp} target="_blank" rel="noopener noreferrer"><WhatsApp/>Conversar com Tadeu <span aria-hidden="true"><Icon name="arrow"/></span></a></section></Base>
