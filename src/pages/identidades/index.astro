---
import Icon from '../../components/Icon.astro';
import Base from '../../layouts/Base.astro';
import {identities} from '../../data/identities';
import '../../styles/identity-board.css';
---
<Base title="Identidades · Glifo" bodyClass="identity-directory"><section class="page-intro wrap"><p class="eyebrow">Arquivo visual / Identidades</p><h1>Os sinais<br/>de cada marca.</h1><aside class="indice-amostras"><div class="indice-papeis" aria-hidden="true"><img src="/identities/ct/manual-1.webp" alt=""/><img src="/identities/acolher/acolher-slide-1.webp" alt=""/><img src="/identities/delfas/manual-1.webp" alt=""/></div><p class="directory-description">Documentos para percorrer as assinaturas, a paleta, as letras e os materiais que compõem cada identidade.</p></aside><div class="cartela-indice" aria-label="Escolher uma identidade pelas cores">{identities.map(board=><a href={`/identidades/${board.slug}/`} aria-label={board.name}><span aria-hidden="true">{board.colors.slice(0,4).map(c=><i style={`background:${c.hex}`}/>)}</span><b>{board.name}</b></a>)}</div></section><div class="identity-index wrap">{identities.map((board,i)=><a href={`/identidades/${board.slug}/`} class:list={['identity-index-item',`identity-index-${board.theme}`]}><span class="identity-directory-index">0{i+1} / IDENTIDADE VISUAL</span><div class="identity-directory-art"><img src={board.hero} alt="" width="1600" height="1000"/></div><div class="indice-tintas" aria-hidden="true">{board.colors.slice(0,5).map(c=><i style={`background:${c.hex}`}/>)}</div><div class="identity-directory-copy"><h2>{board.name}</h2><p>{board.subtitle}</p><span class="quiet-link">Abrir documento da marca <Icon name="arrow"/></span></div></a>)}</div></Base>
