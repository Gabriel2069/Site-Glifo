---
import WhatsApp from '../components/WhatsApp.astro';
import MatrixProof from '../components/MatrixProof.astro';
import Motto from '../components/Motto.astro';
import Icon from '../components/Icon.astro';
import Base from '../layouts/Base.astro';


import Services from '../components/Services.astro';
import BrandDocuments from '../components/BrandDocuments.astro';
import WorkCollection from '../components/WorkCollection.astro';
import Process from '../components/Process.astro';
import Constellation from '../components/Constellation.astro';
import GlyphFormation from '../components/GlyphFormation.astro';
import {site, myth} from '../data/site';

---
<Base bodyClass="editorial-home">
<Fragment slot="head">
 <link rel="preload" as="image" href="/brand/oficio/matriz-detalhe.webp" media="(max-width:760px)" fetchpriority="high"/>
 <link rel="preload" as="image" href="/brand/oficio/matriz-1280.webp" media="(760px < width <= 1280px)" fetchpriority="high"/>
 <link rel="preload" as="image" href="/brand/oficio/matriz-latao.webp" media="(width > 1280px)" fetchpriority="high"/>
</Fragment>
<nav class="chapter-rail" aria-label="Percurso da página"><a href="#trabalhos" aria-label="Trabalhos"><span>01</span></a><a href="#glifo" aria-label="A Glifo"><span>02</span></a><a href="#servicos" aria-label="Serviços"><span>03</span></a><a href="#contato" aria-label="Contato"><span>04</span></a></nav>
<section class="impressao" aria-labelledby="hero-title">
 <div class="impressao-campo" data-prova="matriz">
  <div class="cena-folha" data-folha="matriz"><picture class="matriz-cena"><source media="(max-width:760px)" srcset="/brand/oficio/matriz-detalhe.webp"/><source media="(max-width:1280px)" srcset="/brand/oficio/matriz-1280.webp"/><img src="/brand/oficio/matriz-latao.webp" width="2000" height="1080" fetchpriority="high" decoding="async" alt="Estudo tridimensional do grifo em uma matriz de latão sobre uma pasta violeta, ao lado do cartaz, do cartão e do buril."/></picture></div>
  <div class="cena-folha" data-folha="mesa"><picture><source media="(max-width:760px)" srcset="/brand/oficio/mesa-do-atelie-800.webp"/><img class="mesa-cena" src="/brand/oficio/mesa-panoramica.webp" decoding="async" width="1850" height="875" alt="Proposta, marcador, cartela e peças gráficas da Glifo, reunidos numa composição tridimensional."/></picture></div>
  <div class="cena-folha" data-folha="gravura"><div class="impressao-orbita" aria-hidden="true"></div><picture><source media="(max-width:760px)" srcset="/brand/oficio/garra-suspensa-800.webp"/><img class="impressao-garra" src="/brand/oficio/garra-suspensa.webp" decoding="async" width="1620" height="784" alt="Uma garra gravada em prata se estende da borda da página em direção ao título." /></picture></div>
  <div class="impressao-indice"><span>Glifo · Estúdio de Gabriel Tadeu</span></div>
  <div class="prova-seletor" role="group" aria-label="Ver a identidade da Glifo"><button type="button" data-vista="matriz" aria-pressed="true">Na matriz<i class="tempo-cena" aria-hidden="true"></i></button><button type="button" data-vista="mesa" aria-pressed="false">Na mesa<i class="tempo-cena" aria-hidden="true"></i></button><button type="button" data-vista="gravura" aria-pressed="false">Na gravura<i class="tempo-cena" aria-hidden="true"></i></button><button type="button" hidden data-impressao-play aria-label="Pausar sequência"><span aria-hidden="true"></span></button></div>
  <canvas class="lupa-de-mesa" width="240" height="240" aria-hidden="true"></canvas>
  <MatrixProof/>
  <h1 id="hero-title">O sentido<br/><em class="hero-title-tail">de um traço.</em></h1>
  <div class="impressao-rodape hero-entry"><p>Identidades visuais, sites e publicações.</p><a class="line-link" href="#trabalhos">Ver os trabalhos <Icon name="down"/></a></div>
 </div>
 <div class="prova-de-gestos" aria-label="Gestos do estúdio"><span class="gestos-titulo">Gestos de ofício</span>
 {['avistar','recolher','aferir','inscrever','costurar','selar'].map((nome,i)=><a class="gesto-amostra" href="#processo" data-gesto-etapa={[0,0,1,1,1,2][i]} aria-label={`${nome} · ver a etapa de ${['ideia','ideia','forma','forma','forma','presença'][i]}`}><img src={`/brand/oficio/${nome}.svg`} alt="" width="48" height="48"/><span>{nome}</span></a>)}
 </div>
</section>
<WorkCollection/>
<section class="studio-language invocation" id="glifo" aria-labelledby="language-title"><div class="wrap">
 <header><p class="eyebrow">A Glifo</p><h2 id="language-title">Um ofício<br/><em>feito de sinais.</em></h2><p>Um glifo pode ser uma letra, uma marca, um gesto desenhado. No estúdio, esses sinais acompanham o trabalho desde a primeira conversa até a entrega.</p><a class="quiet-link" href="/identidades/glifo/">Abrir o caderno da marca <Icon name="arrow"/></a></header>
 <div class="hero studio-observatory"><Constellation compact/></div>
</div></section>
<section class="myth myth-theatre" id="origem" aria-labelledby="myth-title"><div class="myth-stage" data-myth-stage data-phase="0"><div class="myth-landscape oficio-surface" aria-hidden="true"></div><div class="myth-vignette"></div><div class="marginalia" aria-hidden="true">{['iris-de-vigilia','barbas-de-prata','remoinho-da-cauda'].map(peca=><img src={`/brand/oficio/${peca}.webp`} alt="" loading="lazy"/> )}</div><GlyphFormation/><div class="myth-stage-label"><span>GLIFO / UMA LEITURA DO CÉU</span><span data-myth-index>I / OS SINAIS</span></div></div><div class="myth-narrative wrap"><header class="myth-title-block"><p class="eyebrow">Sobre glifos, figuras e constelações</p><h2 id="myth-title">O que um sinal<br/><em>permite dizer.</em></h2><p>O céu fornece uma imagem para a marca: pontos que, vistos em relação, passam a formar algo legível. Cada constelação pode ser um glifo.</p></header>{myth.map((chapter,i)=><article class="myth-chapter" data-myth-chapter data-myth-note={chapter.note}><p class="eyebrow">{chapter.note}</p><h3>{chapter.title}</h3><div class="myth-prose">{chapter.text.split("\n\n").map(paragraph=><p class="reading-prose" data-reading-prose>{paragraph}</p>)}</div><span class="chapter-sign" aria-hidden="true">{i===0?'·':i===1?'✦':'✧'}</span></article>)}</div></section>
<Services/><BrandDocuments/><Process/>
<section class="author section wrap" id="autor"><p class="eyebrow">Quem está no estúdio · Goiânia</p><div class="author-grid"><div class="autor-assina"><div class="autor-marca" aria-hidden="true"></div><h2>Gabriel<br/><em>Tadeu.</em></h2><img src="/brand/oficio/inscrever.svg" width="138" height="138" alt="" loading="lazy"/></div><div><p class="big-copy">Na Glifo, desenho identidades, sites e publicações. Gosto de acompanhar o que acontece com uma ideia quando ela sai do papel e chega a alguém.</p><p>Meu trabalho começa tentando entender o que você quer dizer, para quem e em que circunstância. Uma identidade precisa caber num ícone. Um documento precisa conduzir uma leitura longa. Um site precisa responder a quem o percorre. Cada formato pede decisões próprias.</p><p>Aqui você pode abrir os cadernos, ver as peças de perto e acompanhar as escolhas que fiz em cada projeto.</p><a class="quiet-link" href="/trabalhos/glifo/#presenca">O site como projeto <Icon name="arrow"/></a></div></div></section>
<section class="contact-section" id="contato"><img class="contact-lenco" src="/brand/oficio/lenco-de-oficio.webp" width="1760" height="950" loading="lazy" alt="O lenço de ofício da Glifo em uma composição tridimensional, com o grifo e os gestos dourados impressos sobre tecido petróleo."/><video class="contact-lenco lenco-filme" src="/brand/oficio/lenco-em-movimento.webm" preload="none" muted playsinline aria-hidden="true"></video><div class="wrap"><p class="eyebrow">Uma mensagem ainda por escrever</p><h2><Motto/></h2><p>Um nome a desenhar, um site a construir, um conteúdo que precisa ser organizado. Conte onde sua ideia está agora.</p><a class="glifo-action contact-whatsapp" href={site.contact.whatsapp} target="_blank" rel="noopener noreferrer"><WhatsApp/><span><small>Vamos conversar</small>Conte sua ideia a Tadeu</span><span class="action-arrow"><Icon name="arrow"/></span></a><p class="contact-phone">(62) 98301-0176</p><button class="quiet-button" data-open-idea type="button">Preparar minha ideia <Icon name="arrow"/></button></div></section>
</Base>

<script>
 import {initImpression} from '../scripts/impression';
 initImpression();
</script>
